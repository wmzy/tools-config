{
  "name": "tools-config",
  "version": "0.2.3",
  "description": "config for eslint, prettier, typescript and others",
  "scripts": {
    "test": "bash scripts/smoke.sh"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "stylelint",
    "prettier",
    "typescript",
    "tsconfig"
  ],
  "author": "wmzy",
  "license": "ISC",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "config"
  ],
  "exports": {
    "./eslint": {
      "types": "./config/eslint/index.d.ts",
      "default": "./config/eslint/index.mjs"
    },
    "./eslint/type-checked": {
      "types": "./config/eslint/type-checked.d.ts",
      "default": "./config/eslint/type-checked.mjs"
    },
    "./stylelint": "./config/stylelint/index.mjs",
    "./prettier": "./config/prettier.json",
    "./typescript": "./config/typescript/tsconfig.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "stylelint-prettier": "^5.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0 || ^4.0.0",
    "stylelint": "^16.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wmzy/tools-config"
  }
}
